{
  "name": "@souq/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public edge: REST /v1 + GraphQL /graphql over services/search and services/feeds",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/telemetry.js dist/server.js",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --import ./dist/telemetry.js --watch-path=dist dist/server.js)",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "@fastify/otel": "^0.21.2",
    "@fastify/rate-limit": "^11.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation-graphql": "^0.71.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/instrumentation-pino": "^0.69.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "fastify": "^5.12.7",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.5",
    "import-in-the-middle": "^3.5.2",
    "ioredis": "^5.11.1",
    "openapi-fetch": "^0.17.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@souq/contracts": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  }
}
