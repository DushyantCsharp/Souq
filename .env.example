# Copy to .env for local runs. Hostnames here are for processes on the host; infra/compose.apps.yaml
# sets the in-network equivalents (postgres:5432, redpanda:9092, ...) for containers.

# Data services (infra/compose.yaml)
DATABASE_URL=postgres://souq:souq@localhost:55432/souq
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP=localhost:19092
OPENSEARCH_URL=http://localhost:9200

# Internal service URLs (gateway -> search/feeds; storefront -> gateway GraphQL)
SEARCH_URL=http://localhost:8001
FEEDS_URL=http://localhost:8002
GATEWAY_URL=http://localhost:4000/graphql

# Gateway
PAGE_TOKEN_SECRET=dev-only-change-me-32-bytes-minimum!!
GATEWAY_API_KEYS=dev-admin-key

# LLM query parser (replay uses tests/fixtures/llm; no key needed)
ANTHROPIC_API_KEY=
SOUQ_LLM_MODE=replay
SOUQ_LLM_MODEL=claude-haiku-5-5

# Retrieval models
SOUQ_EMBEDDER=fake
SOUQ_RERANKER_MODEL=models/artifacts/reranker-int8
# SOUQ_CONFIG_DIR=config

# OpenTelemetry (collector runs under the compose "obs" profile)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SDK_DISABLED=false
# Key for souq_common.telemetry.hash_query(); must be identical across services so hashes correlate.
SOUQ_TELEMETRY_SALT=dev-only-telemetry-salt
# SOUQ_TELEMETRY_RECORD_QUERY_TEXT=false  # dev-only opt-in to raw query text on spans
