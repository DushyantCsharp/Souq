{
  "name": "@souq/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Postgres schema for Souq: node-pg-migrate SQL migrations (expand/contract) and a migrate CLI",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "node src/migrate.ts",
    "migrate:next": "node src/migrate.ts --include-next",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "node --test test/unit/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "dependencies": {
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.20.0",
    "@eslint/js": "^9.20.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.24.0",
    "typescript": "^5.8.0"
  }
}
